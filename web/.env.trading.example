# Blockchain trading template only. This file is not loaded automatically.
# Keep both switches false until operator and independent security reviews are complete.
FINTRACK_ENABLE_MAINNET_BTC_TRADES=false
FINTRACK_ENABLE_MAINNET_ETH_TRADES=false

# Replace these examples with deployment-approved per-trade maximums.
FINTRACK_MAX_BTC_SWAP=0.001
FINTRACK_MAX_ETH_SWAP=0.01

# Fill both values only after independently verifying the router against official
# THORChain deployment information and Ethereum mainnet. ETH stays disabled otherwise.
FINTRACK_EXPECTED_THORCHAIN_ETH_ROUTER=
FINTRACK_EXPECTED_THORCHAIN_ETH_ROUTER_CODE_HASH=
